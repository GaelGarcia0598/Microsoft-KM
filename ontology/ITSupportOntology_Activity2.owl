<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/ontologies/itsupport#"
     xml:base="http://example.org/ontologies/itsupport"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">

    <owl:Ontology rdf:about="http://example.org/ontologies/itsupport">
        <rdfs:label>IT Technical Support Ontology</rdfs:label>
        <rdfs:comment>Represents how incidents, systems, technicians, tools, documents and customers relate in an IT technical support service.</rdfs:comment>
    </owl:Ontology>

    <!-- ================= Classes ================= -->
    <owl:Class rdf:about="http://example.org/ontologies/itsupport#Incident">
        <rdfs:label>Incident</rdfs:label>
        <rdfs:comment>A reported disruption or request affecting an IT system.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/ontologies/itsupport#Technician">
        <rdfs:label>Technician</rdfs:label>
        <rdfs:comment>A support specialist who diagnoses and resolves incidents.</rdfs:comment>
        <owl:disjointWith rdf:resource="http://example.org/ontologies/itsupport#Customer"/>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/ontologies/itsupport#System">
        <rdfs:label>System</rdfs:label>
        <rdfs:comment>An application, service or infrastructure component supported by the team.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/ontologies/itsupport#Tool">
        <rdfs:label>Tool</rdfs:label>
        <rdfs:comment>Software or utility used to diagnose or fix incidents.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/ontologies/itsupport#Document">
        <rdfs:label>Document</rdfs:label>
        <rdfs:comment>Explicit knowledge such as a knowledge-base article, runbook or incident report.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/ontologies/itsupport#Customer">
        <rdfs:label>Customer</rdfs:label>
        <rdfs:comment>A user or client who reports an incident.</rdfs:comment>
    </owl:Class>

    <owl:AllDisjointClasses>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.org/ontologies/itsupport#Incident"/>
            <rdf:Description rdf:about="http://example.org/ontologies/itsupport#Technician"/>
            <rdf:Description rdf:about="http://example.org/ontologies/itsupport#System"/>
            <rdf:Description rdf:about="http://example.org/ontologies/itsupport#Tool"/>
            <rdf:Description rdf:about="http://example.org/ontologies/itsupport#Document"/>
            <rdf:Description rdf:about="http://example.org/ontologies/itsupport#Customer"/>
        </owl:members>
    </owl:AllDisjointClasses>

    <!-- ================= Object properties ================= -->
    <owl:ObjectProperty rdf:about="http://example.org/ontologies/itsupport#reportedBy">
        <rdfs:label>reportedBy</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontologies/itsupport#Incident"/>
        <rdfs:range rdf:resource="http://example.org/ontologies/itsupport#Customer"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://example.org/ontologies/itsupport#affects">
        <rdfs:label>affects</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontologies/itsupport#Incident"/>
        <rdfs:range rdf:resource="http://example.org/ontologies/itsupport#System"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://example.org/ontologies/itsupport#resolves">
        <rdfs:label>resolves</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontologies/itsupport#Technician"/>
        <rdfs:range rdf:resource="http://example.org/ontologies/itsupport#Incident"/>
        <owl:inverseOf rdf:resource="http://example.org/ontologies/itsupport#resolvedBy"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://example.org/ontologies/itsupport#resolvedBy">
        <rdfs:label>resolvedBy</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontologies/itsupport#Incident"/>
        <rdfs:range rdf:resource="http://example.org/ontologies/itsupport#Technician"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://example.org/ontologies/itsupport#uses">
        <rdfs:label>uses</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontologies/itsupport#Technician"/>
        <rdfs:range rdf:resource="http://example.org/ontologies/itsupport#Tool"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://example.org/ontologies/itsupport#documents">
        <rdfs:label>documents</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontologies/itsupport#Document"/>
        <rdfs:range rdf:resource="http://example.org/ontologies/itsupport#Incident"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://example.org/ontologies/itsupport#describes">
        <rdfs:label>describes</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontologies/itsupport#Document"/>
        <rdfs:range rdf:resource="http://example.org/ontologies/itsupport#System"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://example.org/ontologies/itsupport#dependsOn">
        <rdfs:label>dependsOn</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontologies/itsupport#System"/>
        <rdfs:range rdf:resource="http://example.org/ontologies/itsupport#System"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://example.org/ontologies/itsupport#supports">
        <rdfs:label>supports</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontologies/itsupport#Tool"/>
        <rdfs:range rdf:resource="http://example.org/ontologies/itsupport#System"/>
    </owl:ObjectProperty>

    <!-- ================= Data properties ================= -->
    <owl:DatatypeProperty rdf:about="http://example.org/ontologies/itsupport#incidentId">
        <rdfs:label>incidentId</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontologies/itsupport#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontologies/itsupport#priorityLevel">
        <rdfs:label>priorityLevel</rdfs:label>
        <rdfs:comment>1 = critical, 4 = low.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/ontologies/itsupport#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontologies/itsupport#status">
        <rdfs:label>status</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontologies/itsupport#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontologies/itsupport#openedDate">
        <rdfs:label>openedDate</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontologies/itsupport#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontologies/itsupport#name">
        <rdfs:label>name</rdfs:label>
        <rdfs:comment>Name of a technician, customer, system or tool.</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontologies/itsupport#specialty">
        <rdfs:label>specialty</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontologies/itsupport#Technician"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontologies/itsupport#version">
        <rdfs:label>version</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontologies/itsupport#Document"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontologies/itsupport#title">
        <rdfs:label>title</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontologies/itsupport#Document"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <!-- ================= Example individuals ================= -->
    <owl:NamedIndividual rdf:about="http://example.org/ontologies/itsupport#INC-1001">
        <rdf:type rdf:resource="http://example.org/ontologies/itsupport#Incident"/>
        <incidentId>INC-1001</incidentId>
        <priorityLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</priorityLevel>
        <status>Resolved</status>
        <openedDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-20T09:15:00</openedDate>
        <reportedBy rdf:resource="http://example.org/ontologies/itsupport#Maria_Lopez"/>
        <affects rdf:resource="http://example.org/ontologies/itsupport#VPN_Service"/>
        <resolvedBy rdf:resource="http://example.org/ontologies/itsupport#Carlos_Ruiz"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://example.org/ontologies/itsupport#Carlos_Ruiz">
        <rdf:type rdf:resource="http://example.org/ontologies/itsupport#Technician"/>
        <name>Carlos Ruiz</name>
        <specialty>Network support</specialty>
        <uses rdf:resource="http://example.org/ontologies/itsupport#Remote_Desktop_Tool"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://example.org/ontologies/itsupport#Maria_Lopez">
        <rdf:type rdf:resource="http://example.org/ontologies/itsupport#Customer"/>
        <name>Maria Lopez</name>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://example.org/ontologies/itsupport#VPN_Service">
        <rdf:type rdf:resource="http://example.org/ontologies/itsupport#System"/>
        <name>VPN Service</name>
        <dependsOn rdf:resource="http://example.org/ontologies/itsupport#Authentication_Service"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://example.org/ontologies/itsupport#Authentication_Service">
        <rdf:type rdf:resource="http://example.org/ontologies/itsupport#System"/>
        <name>Authentication Service</name>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://example.org/ontologies/itsupport#Remote_Desktop_Tool">
        <rdf:type rdf:resource="http://example.org/ontologies/itsupport#Tool"/>
        <name>Remote Desktop Tool</name>
        <supports rdf:resource="http://example.org/ontologies/itsupport#VPN_Service"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://example.org/ontologies/itsupport#KB-VPN-Reconnect">
        <rdf:type rdf:resource="http://example.org/ontologies/itsupport#Document"/>
        <title>Reconnecting to the VPN after an expired session</title>
        <version>1.2</version>
        <documents rdf:resource="http://example.org/ontologies/itsupport#INC-1001"/>
        <describes rdf:resource="http://example.org/ontologies/itsupport#VPN_Service"/>
    </owl:NamedIndividual>
</rdf:RDF>
