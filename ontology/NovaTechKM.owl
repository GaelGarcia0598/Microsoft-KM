<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/ontologies/novatech-km#" xml:base="http://example.org/ontologies/novatech-km"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
  <owl:Ontology rdf:about="http://example.org/ontologies/novatech-km">
    <rdfs:label>NovaTech Knowledge Management Ontology</rdfs:label>
    <rdfs:comment>Extends the IT Technical Support ontology with document types, topics, departments and lifecycle stages.</rdfs:comment>
  </owl:Ontology>
  <owl:Class rdf:about="http://example.org/ontologies/novatech-km#Incident"><rdfs:label>Incident</rdfs:label><rdfs:comment>A reported disruption affecting an IT system (from Activity 2).</rdfs:comment></owl:Class>
  <owl:Class rdf:about="http://example.org/ontologies/novatech-km#Technician"><rdfs:label>Technician</rdfs:label><rdfs:comment>A support specialist who resolves incidents and authors documents.</rdfs:comment></owl:Class>
  <owl:Class rdf:about="http://example.org/ontologies/novatech-km#System"><rdfs:label>System</rdfs:label><rdfs:comment>Application, service or infrastructure component supported by NovaTech.</rdfs:comment></owl:Class>
  <owl:Class rdf:about="http://example.org/ontologies/novatech-km#Tool"><rdfs:label>Tool</rdfs:label><rdfs:comment>Software or utility used to diagnose or fix incidents.</rdfs:comment></owl:Class>
  <owl:Class rdf:about="http://example.org/ontologies/novatech-km#Customer"><rdfs:label>Customer</rdfs:label><rdfs:comment>A client or user who reports an incident.</rdfs:comment></owl:Class>
  <owl:Class rdf:about="http://example.org/ontologies/novatech-km#Topic"><rdfs:label>Topic</rdfs:label><rdfs:comment>A subject area used to classify knowledge (VPN, Email, Security...).</rdfs:comment></owl:Class>
  <owl:Class rdf:about="http://example.org/ontologies/novatech-km#Department"><rdfs:label>Department</rdfs:label><rdfs:comment>An organizational unit that owns knowledge.</rdfs:comment></owl:Class>
  <owl:Class rdf:about="http://example.org/ontologies/novatech-km#LifecycleStage"><rdfs:label>LifecycleStage</rdfs:label><rdfs:comment>A stage of the knowledge life cycle.</rdfs:comment></owl:Class>
  <owl:Class rdf:about="http://example.org/ontologies/novatech-km#Document"><rdfs:label>Document</rdfs:label><rdfs:comment>Explicit knowledge stored by NovaTech.</rdfs:comment></owl:Class>
  <owl:Class rdf:about="http://example.org/ontologies/novatech-km#Policy"><rdfs:label>Policy</rdfs:label><rdfs:comment>Rules and obligations (security, privacy, change management).</rdfs:comment><rdfs:subClassOf rdf:resource="http://example.org/ontologies/novatech-km#Document"/></owl:Class>
  <owl:Class rdf:about="http://example.org/ontologies/novatech-km#Manual"><rdfs:label>Manual</rdfs:label><rdfs:comment>Step-by-step user guide or operating instructions.</rdfs:comment><rdfs:subClassOf rdf:resource="http://example.org/ontologies/novatech-km#Document"/></owl:Class>
  <owl:Class rdf:about="http://example.org/ontologies/novatech-km#IncidentReport"><rdfs:label>IncidentReport</rdfs:label><rdfs:comment>Record of an incident: timeline, root cause and corrective action.</rdfs:comment><rdfs:subClassOf rdf:resource="http://example.org/ontologies/novatech-km#Document"/></owl:Class>
  <owl:Class rdf:about="http://example.org/ontologies/novatech-km#KBArticle"><rdfs:label>KBArticle</rdfs:label><rdfs:comment>Troubleshooting article: symptom, cause and solution.</rdfs:comment><rdfs:subClassOf rdf:resource="http://example.org/ontologies/novatech-km#Document"/></owl:Class>
  <owl:Class rdf:about="http://example.org/ontologies/novatech-km#TechnicalDoc"><rdfs:label>TechnicalDoc</rdfs:label><rdfs:comment>Architecture, specification, API or configuration reference.</rdfs:comment><rdfs:subClassOf rdf:resource="http://example.org/ontologies/novatech-km#Document"/></owl:Class>
  <owl:Class rdf:about="http://example.org/ontologies/novatech-km#ProjectReport"><rdfs:label>ProjectReport</rdfs:label><rdfs:comment>Performance, progress, audit and closure reports.</rdfs:comment><rdfs:subClassOf rdf:resource="http://example.org/ontologies/novatech-km#Document"/></owl:Class>
  <owl:ObjectProperty rdf:about="http://example.org/ontologies/novatech-km#reportedBy"><rdfs:label>reportedBy</rdfs:label><rdfs:comment>Incident was reported by a customer.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontologies/novatech-km#Incident"/><rdfs:range rdf:resource="http://example.org/ontologies/novatech-km#Customer"/></owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://example.org/ontologies/novatech-km#affects"><rdfs:label>affects</rdfs:label><rdfs:comment>Incident disrupts a system.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontologies/novatech-km#Incident"/><rdfs:range rdf:resource="http://example.org/ontologies/novatech-km#System"/></owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://example.org/ontologies/novatech-km#resolves"><rdfs:label>resolves</rdfs:label><rdfs:comment>Technician resolves an incident.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontologies/novatech-km#Technician"/><rdfs:range rdf:resource="http://example.org/ontologies/novatech-km#Incident"/></owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://example.org/ontologies/novatech-km#uses"><rdfs:label>uses</rdfs:label><rdfs:comment>Technician uses a tool.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontologies/novatech-km#Technician"/><rdfs:range rdf:resource="http://example.org/ontologies/novatech-km#Tool"/></owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://example.org/ontologies/novatech-km#supports"><rdfs:label>supports</rdfs:label><rdfs:comment>Tool supports a system.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontologies/novatech-km#Tool"/><rdfs:range rdf:resource="http://example.org/ontologies/novatech-km#System"/></owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://example.org/ontologies/novatech-km#dependsOn"><rdfs:label>dependsOn</rdfs:label><rdfs:comment>System relies on another system.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontologies/novatech-km#System"/><rdfs:range rdf:resource="http://example.org/ontologies/novatech-km#System"/></owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://example.org/ontologies/novatech-km#documents"><rdfs:label>documents</rdfs:label><rdfs:comment>Document records or explains an incident.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontologies/novatech-km#Document"/><rdfs:range rdf:resource="http://example.org/ontologies/novatech-km#Incident"/></owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://example.org/ontologies/novatech-km#describes"><rdfs:label>describes</rdfs:label><rdfs:comment>Document describes a system.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontologies/novatech-km#Document"/><rdfs:range rdf:resource="http://example.org/ontologies/novatech-km#System"/></owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://example.org/ontologies/novatech-km#aboutTopic"><rdfs:label>aboutTopic</rdfs:label><rdfs:comment>Document belongs to a topic.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontologies/novatech-km#Document"/><rdfs:range rdf:resource="http://example.org/ontologies/novatech-km#Topic"/></owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://example.org/ontologies/novatech-km#authoredBy"><rdfs:label>authoredBy</rdfs:label><rdfs:comment>Document was written by a technician.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontologies/novatech-km#Document"/><rdfs:range rdf:resource="http://example.org/ontologies/novatech-km#Technician"/></owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://example.org/ontologies/novatech-km#ownedBy"><rdfs:label>ownedBy</rdfs:label><rdfs:comment>Department responsible for the document.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontologies/novatech-km#Document"/><rdfs:range rdf:resource="http://example.org/ontologies/novatech-km#Department"/></owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://example.org/ontologies/novatech-km#inStage"><rdfs:label>inStage</rdfs:label><rdfs:comment>Current lifecycle stage of the document.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontologies/novatech-km#Document"/><rdfs:range rdf:resource="http://example.org/ontologies/novatech-km#LifecycleStage"/></owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://example.org/ontologies/novatech-km#memberOf"><rdfs:label>memberOf</rdfs:label><rdfs:comment>Technician belongs to a department.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontologies/novatech-km#Technician"/><rdfs:range rdf:resource="http://example.org/ontologies/novatech-km#Department"/></owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://example.org/ontologies/novatech-km#supersedes"><rdfs:label>supersedes</rdfs:label><rdfs:comment>A newer document replaces an older one.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontologies/novatech-km#Document"/><rdfs:range rdf:resource="http://example.org/ontologies/novatech-km#Document"/></owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://example.org/ontologies/novatech-km#relatedTo"><rdfs:label>relatedTo</rdfs:label><rdfs:comment>Documents that complement each other.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontologies/novatech-km#Document"/><rdfs:range rdf:resource="http://example.org/ontologies/novatech-km#Document"/></owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://example.org/ontologies/novatech-km#derivedFrom"><rdfs:label>derivedFrom</rdfs:label><rdfs:comment>KB article created from a resolved incident report.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontologies/novatech-km#KBArticle"/><rdfs:range rdf:resource="http://example.org/ontologies/novatech-km#IncidentReport"/></owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://example.org/ontologies/novatech-km#solves"><rdfs:label>solves</rdfs:label><rdfs:comment>KB article gives the fix for a type of incident.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontologies/novatech-km#KBArticle"/><rdfs:range rdf:resource="http://example.org/ontologies/novatech-km#Incident"/></owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://example.org/ontologies/novatech-km#governs"><rdfs:label>governs</rdfs:label><rdfs:comment>Policy sets rules for a system.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontologies/novatech-km#Policy"/><rdfs:range rdf:resource="http://example.org/ontologies/novatech-km#System"/></owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://example.org/ontologies/novatech-km#guides"><rdfs:label>guides</rdfs:label><rdfs:comment>Manual instructs users.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontologies/novatech-km#Manual"/><rdfs:range rdf:resource="http://example.org/ontologies/novatech-km#Customer"/></owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://example.org/ontologies/novatech-km#summarizes"><rdfs:label>summarizes</rdfs:label><rdfs:comment>Report aggregates incident metrics.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontologies/novatech-km#ProjectReport"/><rdfs:range rdf:resource="http://example.org/ontologies/novatech-km#Incident"/></owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/ontologies/novatech-km#title"><rdfs:label>title</rdfs:label><rdfs:domain rdf:resource="http://example.org/ontologies/novatech-km#Document"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/ontologies/novatech-km#version"><rdfs:label>version</rdfs:label><rdfs:domain rdf:resource="http://example.org/ontologies/novatech-km#Document"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/ontologies/novatech-km#lastReviewed"><rdfs:label>lastReviewed</rdfs:label><rdfs:domain rdf:resource="http://example.org/ontologies/novatech-km#Document"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/ontologies/novatech-km#incidentId"><rdfs:label>incidentId</rdfs:label><rdfs:domain rdf:resource="http://example.org/ontologies/novatech-km#Incident"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/ontologies/novatech-km#priorityLevel"><rdfs:label>priorityLevel</rdfs:label><rdfs:domain rdf:resource="http://example.org/ontologies/novatech-km#Incident"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/ontologies/novatech-km#status"><rdfs:label>status</rdfs:label><rdfs:domain rdf:resource="http://example.org/ontologies/novatech-km#Incident"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/ontologies/novatech-km#name"><rdfs:label>name</rdfs:label><rdfs:domain rdf:resource="http://example.org/ontologies/novatech-km#Technician"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/ontologies/novatech-km#specialty"><rdfs:label>specialty</rdfs:label><rdfs:domain rdf:resource="http://example.org/ontologies/novatech-km#Technician"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="http://example.org/ontologies/novatech-km#VPN_Service"><rdf:type rdf:resource="http://example.org/ontologies/novatech-km#System"/></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://example.org/ontologies/novatech-km#Email_Service"><rdf:type rdf:resource="http://example.org/ontologies/novatech-km#System"/></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://example.org/ontologies/novatech-km#Topic_VPN"><rdf:type rdf:resource="http://example.org/ontologies/novatech-km#Topic"/></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://example.org/ontologies/novatech-km#Topic_Security"><rdf:type rdf:resource="http://example.org/ontologies/novatech-km#Topic"/></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://example.org/ontologies/novatech-km#Dept_Support"><rdf:type rdf:resource="http://example.org/ontologies/novatech-km#Department"/></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://example.org/ontologies/novatech-km#Dept_Operations"><rdf:type rdf:resource="http://example.org/ontologies/novatech-km#Department"/></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://example.org/ontologies/novatech-km#Stage_Share"><rdf:type rdf:resource="http://example.org/ontologies/novatech-km#LifecycleStage"/></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://example.org/ontologies/novatech-km#Stage_Apply"><rdf:type rdf:resource="http://example.org/ontologies/novatech-km#LifecycleStage"/></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://example.org/ontologies/novatech-km#Carlos_Ruiz"><rdf:type rdf:resource="http://example.org/ontologies/novatech-km#Technician"/><memberOf rdf:resource="http://example.org/ontologies/novatech-km#Dept_Support"/><resolves rdf:resource="http://example.org/ontologies/novatech-km#INC-1001"/></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://example.org/ontologies/novatech-km#INC-1001"><rdf:type rdf:resource="http://example.org/ontologies/novatech-km#Incident"/><affects rdf:resource="http://example.org/ontologies/novatech-km#VPN_Service"/></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://example.org/ontologies/novatech-km#IR-INC-1001"><rdf:type rdf:resource="http://example.org/ontologies/novatech-km#IncidentReport"/><documents rdf:resource="http://example.org/ontologies/novatech-km#INC-1001"/><aboutTopic rdf:resource="http://example.org/ontologies/novatech-km#Topic_VPN"/><authoredBy rdf:resource="http://example.org/ontologies/novatech-km#Carlos_Ruiz"/><ownedBy rdf:resource="http://example.org/ontologies/novatech-km#Dept_Operations"/></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://example.org/ontologies/novatech-km#KB-201"><rdf:type rdf:resource="http://example.org/ontologies/novatech-km#KBArticle"/><derivedFrom rdf:resource="http://example.org/ontologies/novatech-km#IR-INC-1001"/><solves rdf:resource="http://example.org/ontologies/novatech-km#INC-1001"/><aboutTopic rdf:resource="http://example.org/ontologies/novatech-km#Topic_VPN"/><describes rdf:resource="http://example.org/ontologies/novatech-km#VPN_Service"/><inStage rdf:resource="http://example.org/ontologies/novatech-km#Stage_Share"/></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://example.org/ontologies/novatech-km#Policy-Remote-Work"><rdf:type rdf:resource="http://example.org/ontologies/novatech-km#Policy"/><governs rdf:resource="http://example.org/ontologies/novatech-km#VPN_Service"/><aboutTopic rdf:resource="http://example.org/ontologies/novatech-km#Topic_Security"/><relatedTo rdf:resource="http://example.org/ontologies/novatech-km#KB-201"/></owl:NamedIndividual>
</rdf:RDF>